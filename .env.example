# Copie para .env e ajuste os valores. O .env nunca vai para o git.
# Usado pelo `docker compose --profile app up`; no desenvolvimento local os padrões de application-dev.yml bastam.

POSTGRES_DB=jobhunter
POSTGRES_USER=jobhunter
POSTGRES_PASSWORD=troque-esta-senha

# Login do backoffice.
JOBHUNTER_USER=admin
# Hash bcrypt da senha, entre aspas simples para o compose não interpretar os "$". Para gerar:
#   docker run --rm httpd:2.4-alpine htpasswd -nbBC 10 "" 'sua-senha' | tr -d ':\n' | sed 's/^/{bcrypt}/'
JOBHUNTER_PASSWORD_HASH='{bcrypt}$2y$10$substitua-pelo-hash-gerado'

# Storage S3 compatível dos currículos (RustFS local; S3 ou Cloudflare R2 em produção).
JOBHUNTER_STORAGE_ACCESS_KEY=jobhunter
JOBHUNTER_STORAGE_SECRET_KEY=troque-este-segredo
JOBHUNTER_STORAGE_BUCKET=jobhunter-resumes
# Endereço do storage visto pelo navegador, usado nas URLs pré-assinadas de download.
JOBHUNTER_STORAGE_PUBLIC_ENDPOINT=http://localhost:9000

# Chave e salt (hexadecimal, 16+ dígitos) que cifram os tokens do Gmail no banco. Para gerar:
#   openssl rand -base64 32      (chave)
#   openssl rand -hex 8          (salt)
JOBHUNTER_ENCRYPTION_KEY=troque-esta-chave
JOBHUNTER_ENCRYPTION_SALT=0000000000000000

# Gmail (Fase 2): credencial OAuth do tipo "Aplicativo da Web" no Google Cloud, com a Gmail API ativada.
# O redirect URI cadastrado no Google precisa ser exatamente o JOBHUNTER_GMAIL_REDIRECT_URI.
JOBHUNTER_GMAIL_CLIENT_ID=
JOBHUNTER_GMAIL_CLIENT_SECRET=
JOBHUNTER_GMAIL_REDIRECT_URI=http://localhost:8081/api/admin/gmail/callback
JOBHUNTER_GMAIL_AFTER_CONNECT_URL=http://localhost:8081/settings
JOBHUNTER_GMAIL_LABEL=jobs

# Análise por IA (Fase 3). Sem a chave, a análise roda só com o dicionário e as regras.
JOBHUNTER_AI_API_KEY=
